# What scripts/build.sh builds and scripts/publish.sh publishes. A change here, pushed to Forgejo,
# runs the workflow (.forgejo/workflows/build.yml).

# The Jetson Linux (L4T) release. NVIDIA publishes no checksum for the BSP, so its first download
# is the pin: curl -fL <url> | sha256sum.
L4T_VERSION=39.2.1
BSP_URL=https://developer.download.nvidia.com/embedded/L4T/r39_Release_v2.1/release/Jetson_Linux_R39.2.1_aarch64.tbz2
BSP_SHA256=2e5619088ba88e85dab25247f033d70659b6f676ff835176a07766dcb0fdbe6b
# NVIDIA's apt index for the release. Every published deb but the rebuild must match it.
NVIDIA_INDEX_URL=https://repo.download.nvidia.com/jetson/som/dists/r39.2/main/binary-arm64/Packages

# The rebuild's version is NVIDIA's plus "+<suffix>". A second build of the same release needs a
# higher suffix (tp2): the registry refuses a version it already has, and apt wouldn't upgrade.
REPACK_SUFFIX=tp1
# The capsule nvidia-l4t-bootloader's install script stages for jetson-orin-nano-devkit-super,
# the name it gives the P3767-0005 module, and the BUP spec that builds it.
BUP_SPEC=t23x_3767_bl_super_spec
CAPSULE=TEGRA_BL_3767_super.Cap

# Where publish.sh puts the release: Forgejo's Debian registry, as owner, distribution, component.
REPO_OWNER=homelab
REPO_DISTRIBUTION=l4t-bootloader-no-carrier-eeprom
REPO_COMPONENT=main
